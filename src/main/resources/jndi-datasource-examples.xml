<!--
  PostgreSQL JNDI DataSource Configuration Examples
  
  This file provides configuration examples for various Jakarta EE application servers.
  Choose the appropriate configuration for your target server.
-->

<!-- ========================================
     WildFly / JBoss EAP Configuration
     ======================================== -->
<!--
  File: standalone.xml or domain.xml
  Location: $JBOSS_HOME/standalone/configuration/
-->
<datasources xmlns="urn:jboss:domain:datasources:6.0">
    <datasource jndi-name="java:jboss/datasources/ModResortsDS" 
                pool-name="ModResortsPool" 
                enabled="true" 
                use-java-context="true">
        <connection-url>jdbc:postgresql://localhost:5432/modresorts</connection-url>
        <driver>postgresql</driver>
        <security>
            <user-name>postgres</user-name>
            <password>postgres</password>
        </security>
        <validation>
            <valid-connection-checker class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker"/>
            <exception-sorter class-name="org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter"/>
        </validation>
        <pool>
            <min-pool-size>5</min-pool-size>
            <max-pool-size>20</max-pool-size>
            <prefill>true</prefill>
        </pool>
        <timeout>
            <idle-timeout-minutes>10</idle-timeout-minutes>
        </timeout>
        <statement>
            <prepared-statement-cache-size>32</prepared-statement-cache-size>
        </statement>
    </datasource>
    
    <drivers>
        <driver name="postgresql" module="org.postgresql">
            <xa-datasource-class>org.postgresql.xa.PGXADataSource</xa-datasource-class>
        </driver>
    </drivers>
</datasources>

<!-- ========================================
     Apache Tomcat Configuration
     ======================================== -->
<!--
  File: context.xml or server.xml
  Location: $CATALINA_HOME/conf/
-->
<Context>
    <Resource name="jdbc/ModResortsJndi"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="org.postgresql.Driver"
              url="jdbc:postgresql://localhost:5432/modresorts"
              username="postgres"
              password="postgres"
              maxTotal="20"
              maxIdle="10"
              minIdle="5"
              maxWaitMillis="10000"
              testOnBorrow="true"
              validationQuery="SELECT 1"
              removeAbandonedOnBorrow="true"
              removeAbandonedTimeout="60"
              logAbandoned="true"/>
</Context>

<!-- ========================================
     GlassFish / Payara Configuration
     ======================================== -->
<!--
  Configure via Admin Console or asadmin CLI:
  
  1. Create JDBC Connection Pool:
  asadmin create-jdbc-connection-pool \
    --datasourceclassname org.postgresql.ds.PGSimpleDataSource \
    --restype javax.sql.DataSource \
    --property user=postgres:password=postgres:serverName=localhost:portNumber=5432:databaseName=modresorts \
    ModResortsPool
  
  2. Create JDBC Resource:
  asadmin create-jdbc-resource \
    --connectionpoolid ModResortsPool \
    jdbc/ModResortsJndi
  
  3. Ping to test:
  asadmin ping-connection-pool ModResortsPool
-->

<!-- ========================================
     Open Liberty Configuration
     ======================================== -->
<!--
  File: server.xml
  Location: $WLP_HOME/usr/servers/[server-name]/
-->
<server>
    <!-- PostgreSQL JDBC Driver Library -->
    <library id="PostgreSQLLib">
        <fileset dir="${shared.resource.dir}/postgresql" includes="postgresql-42.7.1.jar"/>
    </library>
    
    <!-- DataSource Configuration -->
    <dataSource id="ModResortsDS" jndiName="jdbc/ModResortsJndi">
        <jdbcDriver libraryRef="PostgreSQLLib"/>
        <properties.postgresql 
            serverName="localhost"
            portNumber="5432"
            databaseName="modresorts"
            user="postgres"
            password="postgres"
            currentSchema="public"/>
        <connectionManager 
            maxPoolSize="20"
            minPoolSize="5"
            connectionTimeout="30s"
            maxIdleTime="10m"
            reapTime="3m"
            agedTimeout="30m"/>
    </dataSource>
</server>

<!-- ========================================
     WebLogic Configuration
     ======================================== -->
<!--
  Configure via WebLogic Admin Console:
  
  1. Domain > Services > Data Sources > New > Generic Data Source
  2. Name: ModResortsDS
  3. JNDI Name: jdbc/ModResortsJndi
  4. Database Type: PostgreSQL
  5. Database Driver: PostgreSQL's Driver (Thin) for Instance connections
  6. Connection Properties:
     - Database Name: modresorts
     - Host Name: localhost
     - Port: 5432
     - Database User Name: postgres
     - Password: postgres
  7. Test Configuration
  8. Target to appropriate server/cluster
-->

